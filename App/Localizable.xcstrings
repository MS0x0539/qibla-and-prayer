          "stringUnit": {
            "state": "translated",
            "value": "يبدأ %@ بعد %lld د، عند %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beginnt in %lld Minuten, um %@."
          }
        },
        "fr": {
