    "Allow notifications for this app in iPhone Settings to get reminders.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بإشعارات هذا التطبيق في إعدادات iPhone لتصلك التنبيهات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Mitteilungen für diese App in den iPhone-Einstellungen, um Erinnerungen zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez les notifications de cette app dans les Réglages de l’iPhone pour recevoir des rappels."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta meldingen voor deze app toe in de iPhone-instellingen om herinneringen te krijgen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma almak için iPhone Ayarlar'ında bu uygulamanın bildirimlerine izin verin."
          }
        }
      }
    },
    "Allow notifications in Settings": {
