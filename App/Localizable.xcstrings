            "value": "Die in diesem Khatm bisher gelesenen Seiten werden gelöscht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages déjà lues de ce khatm sont effacées."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De pagina's die je in deze khatm al las, worden gewist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hatimde şimdiye kadar okunan sayfalar silinir."
          }
        }
      }
    },
    "The recitation can't be loaded": {
