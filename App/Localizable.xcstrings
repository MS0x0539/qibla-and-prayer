    "Suhoor ends at Fajr. Iftar is at Maghrib.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي السحور عند الفجر، والإفطار عند المغرب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Suhur endet mit Fajr. Iftar ist zu Maghrib."
          }
        },
        "fr": {
