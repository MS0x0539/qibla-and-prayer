    "Notifications are off for this app. You can turn them on in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإشعارات متوقفة لهذا التطبيق. يمكنك تفعيلها من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für diese App ausgeschaltet. Du kannst sie in den Einstellungen einschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées pour cette app. Vous pouvez les activer dans Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit voor deze app. Je kunt ze aanzetten in Instellingen."
