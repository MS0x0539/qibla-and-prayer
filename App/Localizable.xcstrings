    "Turn slowly until the gold Kaaba marker reaches the mark at the top. The star fills in and your phone taps once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استدر ببطء حتى تصل علامة الكعبة الذهبية إلى العلامة في الأعلى. عندها تمتلئ النجمة ويهتز هاتفك مرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh dich langsam, bis die goldene Kaaba die Markierung oben erreicht. Der Stern füllt sich und dein iPhone tippt einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez lentement jusqu’à ce que la Kaaba dorée atteigne le repère en haut. L’étoile se remplit et votre téléphone vibre une fois."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai langzaam tot de gouden Kaaba bij het streepje bovenaan staat. De ster kleurt goud en je telefoon tikt één keer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Altın renkli Kâbe işareti üstteki işarete gelene kadar yavaşça dönün. Yıldız dolar ve telefonunuz bir kez titrer."
          }
        }
      }
    },
    "Turn until the Kaaba marker reaches the top.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استدر حتى تصل علامة الكعبة إلى الأعلى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh dich, bis die Kaaba oben steht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez jusqu’à ce que la Kaaba soit en haut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draai tot de Kaaba bovenaan staat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kâbe işareti en üste gelene kadar dönün."
          }
        }
      }
    },
