    "Today's times, the next prayer and a monthly timetable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت اليوم والصلاة القادمة وجدول شهري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiten von heute, das nächste Gebet und eine Monatsübersicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires du jour, la prochaine prière et un calendrier mensuel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijden van vandaag, het volgende gebed en een maandoverzicht."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün vakitleri, sıradaki vakit ve aylık vakitler."
          }
        }
      }
    },
