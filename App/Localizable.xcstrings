    "This device has no compass. The Qibla is at %lld° from north.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الجهاز على بوصلة. اتجاه القبلة %lld° من الشمال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keinen Kompass. Die Qibla liegt bei %lld° von Norden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas de boussole. La qibla est à %lld° du nord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft geen kompas. De qibla ligt op %lld° vanaf het noorden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda pusula yok. Kıble, kuzeyden %lld° yönündedir."
          }
        }
      }
    },
