          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için bildirimler kapalı. Ayarlar'dan açabilirsiniz."
          }
        }
      }
    },
    "Notifications use the standard sound. The test notification arrives after 5 seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم الإشعارات الصوت الافتراضي. يصل الإشعار التجريبي بعد ٥ ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen nutzen den Standardton. Die Testmitteilung kommt nach 5 Sekunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications utilisent le son standard. La notification de test arrive après 5 secondes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen gebruiken het standaardgeluid. De testmelding komt na 5 seconden."
