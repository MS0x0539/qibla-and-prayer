    "Add a prayer you missed, and take it off once you have made it up. All of this stays on your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الصلاة التي فاتتك، واحذفها بعد قضائها. يبقى كل هذا على iPhone الخاص بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein verpasstes Gebet hinzu und nimm es weg, sobald du es nachgeholt hast. Alles bleibt auf deinem iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une prière manquée, puis retirez-la une fois rattrapée. Tout reste sur votre iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tel een gemist gebed op, en haal het eraf zodra je het hebt ingehaald. Dit alles blijft op je iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kılamadığınız bir namazı ekleyin, kaza ettiğinizde düşün. Bunların hepsi iPhone'unuzda kalır."
          }
        }
      }
    },
    "Adjust times": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعديل المواقيت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten anpassen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuster les horaires"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijden aanpassen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitleri ayarla"
          }
        }
      }
    },
    "Adjusts Fajr and Isha by season. Used in the UK and North America.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعدّل الفجر والعشاء حسب الفصل. تُستخدم في المملكة المتحدة وأمريكا الشمالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt Fajr und Isha an die Jahreszeit an. Genutzt in Großbritannien und Nordamerika."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste Fajr et Isha selon la saison. Utilisée au Royaume-Uni et en Amérique du Nord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Past Fajr en Isha aan per seizoen. Gebruikt in het VK en Noord-Amerika."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmsak ve yatsıyı mevsime göre ayarlar. Birleşik Krallık ve Kuzey Amerika'da kullanılır."
          }
        }
      }
    },
