    "A notification when each prayer begins, if you want one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه عند دخول وقت كل صلاة، إن أردت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn ein Gebet beginnt – wenn du möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification au début de chaque prière, si vous le souhaitez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding als een gebed begint, als je dat wilt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz her vakit girdiğinde bir bildirim."
          }
        }
      }
    },
    "A page counts as read once it has been open for 10 seconds. All 604 pages complete a khatm.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب الصفحة مقروءة بعد بقائها مفتوحة ١٠ ثوانٍ. وتكتمل الختمة بقراءة الصفحات الـ٦٠٤ كلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Seite gilt als gelesen, sobald sie 10 Sekunden offen war. Alle 604 Seiten ergeben ein Khatm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une page compte comme lue après 10 secondes d’ouverture. Les 604 pages forment un khatm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een pagina telt als gelezen als hij 10 seconden open is geweest. Alle 604 pagina's samen vormen een khatm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sayfa 10 saniye açık kaldığında okunmuş sayılır. 604 sayfanın tamamı bir hatim eder."
          }
        }
      }
    },
