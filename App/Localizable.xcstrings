        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredesiniz?"
          }
        }
      }
    },
    "Which language?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي لغة تفضّل؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Welche Sprache?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle langue ?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welke taal?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi dil?"
          }
        }
      }
    },
    "Without location access the compass uses magnetic north, which can be a few degrees off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون الوصول إلى الموقع تعتمد البوصلة على الشمال المغناطيسي، وقد يختلف بضع درجات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Standortzugriff nutzt der Kompass den magnetischen Norden, der um einige Grad abweichen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans accès à la position, la boussole utilise le nord magnétique, qui peut différer de quelques degrés."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder locatietoegang wijst het kompas het magnetische noorden aan; dat kan een paar graden afwijken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi olmadan pusula manyetik kuzeyi kullanır; bu birkaç derece sapabilir."
          }
        }
      }
    },
    "Witr": {
