    "Minutes added to the calculated time, to match the timetable of your mosque.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقائق تُضاف إلى الوقت المحسوب ليطابق جدول مسجدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten, die zur berechneten Zeit addiert werden, damit sie zum Gebetsplan deiner Moschee passt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes ajoutées à l’heure calculée, pour correspondre aux horaires de votre mosquée."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuten die bij de berekende tijd worden opgeteld, zodat die met de tijden van je moskee overeenkomt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiinizin takvimine uyması için hesaplanan vakte eklenen dakikalar."
          }
        }
      }
    },
