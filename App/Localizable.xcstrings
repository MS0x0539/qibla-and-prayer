    },
    "Works without location access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل دون الوصول إلى الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktioniert ohne Standortzugriff."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne sans accès à la position."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt zonder locatietoegang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum erişimi olmadan çalışır."
          }
        }
      }
    },
    "You can change all of this any time in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير كل ذلك في أي وقت من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst all das jederzeit in den Einstellungen ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez tout modifier à tout moment dans Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit allemaal altijd wijzigen in Instellingen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunların hepsini istediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        }
      }
    },
    "Your location could not be found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد موقعك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort konnte nicht ermittelt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de déterminer votre position."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie kon niet worden bepaald."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz belirlenemedi."
          }
        }
      }
    },
    "Your settings go back to the suggestions for your region, and the setup starts again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعود إعداداتك إلى المقترحات الخاصة بمنطقتك، ويبدأ الإعداد من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Einstellungen werden auf die Vorschläge für deine Region zurückgesetzt und die Einrichtung beginnt neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos réglages reviennent aux suggestions pour votre région et la configuration recommence."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je instellingen gaan terug naar de suggesties voor jouw regio en het instellen begint opnieuw."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlarınız bölgeniz için önerilen değerlere döner ve kurulum yeniden başlar."
          }
        }
      }
    },
    "qada.fajr": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفجر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fajr"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fajr"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fajr"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah"
          }
        }
      }
    },
    "“Remind me before” adds a notification a few minutes before each prayer that has its bell on. The Jumu'ah reminder comes an hour before the Friday prayer. In Ramadan you get one 30 minutes before suhoor ends, and one at iftar. Notifications use the standard sound; the test notification arrives after 5 seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "«ذكّرني قبلها» يرسل إشعارًا قبل كل صلاة جرسها مفعّل ببضع دقائق. يصل تذكير الجمعة قبل صلاة الجمعة بساعة. وفي رمضان يصلك تذكير قبل انتهاء السحور بـ٣٠ دقيقة وآخر عند الإفطار. تستخدم الإشعارات الصوت الافتراضي، ويصل الإشعار التجريبي بعد ٥ ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Vorher erinnern“ schickt einige Minuten vor jedem Gebet mit eingeschalteter Glocke eine Mitteilung. Die Erinnerung ans Freitagsgebet kommt eine Stunde vorher. Im Ramadan bekommst du eine 30 Minuten vor Ende des Suhur und eine zum Iftar. Mitteilungen nutzen den Standardton; die Testmitteilung kommt nach 5 Sekunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Me rappeler avant » envoie une notification quelques minutes avant chaque prière dont la cloche est activée. Le rappel de la prière du vendredi arrive une heure avant. Pendant le ramadan, vous en recevez un 30 minutes avant la fin du sahour et un à l’iftar. Les notifications utilisent le son standard ; la notification de test arrive après 5 secondes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Herinner me vooraf’ stuurt een melding een paar minuten voor elk gebed met de bel aan. De herinnering voor het vrijdaggebed komt een uur ervoor. Tijdens de ramadan krijg je er een 30 minuten voor het einde van de suhoor, en een bij de iftar. Meldingen gebruiken het standaardgeluid; de testmelding komt na 5 seconden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Önceden hatırlat”, zili açık olan her vakitten birkaç dakika önce bildirim gönderir. Cuma hatırlatması cuma namazından bir saat önce gelir. Ramazan'da imsaktan 30 dakika önce ve iftarda birer bildirim alırsınız. Bildirimler standart sesi kullanır; deneme bildirimi 5 saniye sonra gelir."
          }
        }
      }
    }
  },
  "version": "1.0"
}
