            "state": "translated",
            "value": "Tilavet yüklenemiyor"
          }
        }
      }
    },
    "The rules of the mosques in the country you're in, also when you travel. Now: %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قواعد مساجد البلد الذي أنت فيه، حتى في السفر. الآن: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln der Moscheen in dem Land, in dem du bist, auch auf Reisen. Jetzt: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles des mosquées du pays où vous êtes, même en voyage. Actuellement : %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regels van de moskeeën in het land waar je bent, ook op reis. Nu: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğunuz ülkedeki camilerin hesabı, seyahatte de. Şu an: %@"
          }
        }
      }
    },
    "The whole Qur'an": {
      "localizations": {
        "ar": {
          "stringUnit": {
