            "value": "Het volgende gebed, de tijd en een aftelling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki vakit, saati ve geri sayım."
          }
        }
      }
    },
    "The pages read so far in this khatm are cleared.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُمحى الصفحات المقروءة حتى الآن في هذه الختمة."
          }
        },
        "de": {
          "stringUnit": {
