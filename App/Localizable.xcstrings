    "Changes the language of this app only. Messages from iOS itself, such as permission requests, follow the language of your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر لغة هذا التطبيق فقط. أما رسائل iOS نفسه، مثل طلبات الأذونات، فتتبع لغة iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nur die Sprache dieser App. Meldungen von iOS selbst, etwa Berechtigungsanfragen, folgen der Sprache deines iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change uniquement la langue de cette app. Les messages d’iOS lui-même, comme les demandes d’autorisation, suivent la langue de votre iPhone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verandert alleen de taal van deze app. Berichten van iOS zelf, zoals toestemmingsvragen, volgen de taal van je iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu uygulamanın dilini değiştirir. İzin istekleri gibi iOS'un kendi mesajları iPhone'unuzun dilini izler."
          }
        }
      }
    },
    "Choose a city": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مدينة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadt wählen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une ville"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een stad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehir seçin"
          }
        }
      }
    },
    "Choose the method your mosque uses. You can move each prayer by a few minutes to match its timetable, and the Hijri date by a day or two.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الطريقة التي يتبعها مسجدك. يمكنك تقديم كل صلاة أو تأخيرها بضع دقائق لتطابق جدوله، وتعديل التاريخ الهجري يومًا أو يومين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Methode deiner Moschee. Du kannst jedes Gebet um ein paar Minuten verschieben, damit es zum Gebetsplan passt, und das Hidschri-Datum um ein, zwei Tage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la méthode de votre mosquée. Vous pouvez décaler chaque prière de quelques minutes pour correspondre à ses horaires, et la date hégirienne d’un ou deux jours."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de methode die je moskee gebruikt. Je kunt elk gebed een paar minuten verschuiven zodat het met de tijden van je moskee overeenkomt, en de Hidjri-datum een dag of twee."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Camiinizin kullandığı yöntemi seçin. Her vakti camiinizin takvimine uyması için birkaç dakika, hicri tarihi de bir iki gün kaydırabilirsiniz."
          }
        }
      }
    },
    "Choose your location, calculation method and reminders again, step by step.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقعك وطريقة الحساب والتنبيهات من جديد، خطوة بخطوة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Standort, Berechnungsmethode und Erinnerungen Schritt für Schritt neu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez à nouveau votre position, la méthode de calcul et les rappels, étape par étape."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je locatie, berekeningsmethode en herinneringen opnieuw, stap voor stap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuzu, hesaplama yöntemini ve hatırlatmaları adım adım yeniden seçin."
          }
        }
      }
    },
    "City": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدينة"
