    "Location access is off for this app. Choose a city instead, or turn it on in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف لهذا التطبيق. اختر مدينة بدلًا من ذلك، أو فعّله من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standortzugriff ist für diese App ausgeschaltet. Wähle stattdessen eine Stadt oder schalte ihn in den Einstellungen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé pour cette app. Choisissez une ville, ou activez-le dans Réglages."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang staat uit voor deze app. Kies een stad, of zet het aan in Instellingen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama için konum erişimi kapalı. Bir şehir seçin ya da Ayarlar'dan açın."
