    "A notification when each prayer begins, if you want one.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنبيه عند دخول وقت كل صلاة، إن أردت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mitteilung, wenn ein Gebet beginnt – wenn du möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une notification au début de chaque prière, si vous le souhaitez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een melding als een gebed begint, als je dat wilt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsterseniz her vakit girdiğinde bir bildirim."
          }
        }
      }
    },
