    "Recitations stream verse by verse from Islamic Network (alquran.cloud) and remain the copyright of their reciters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي التلاوات آيةً آيةً من Islamic Network ‏(alquran.cloud)، وتبقى حقوقها لقرّائها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Rezitationen kommen Vers für Vers von Islamic Network (alquran.cloud); das Urheberrecht bleibt bei den Rezitatoren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les récitations sont diffusées verset par verset depuis Islamic Network (alquran.cloud) et restent la propriété de leurs récitateurs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De recitaties komen vers voor vers van Islamic Network (alquran.cloud); het auteursrecht blijft bij de reciteurs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilavetler ayet ayet Islamic Network'ten (alquran.cloud) gelir; telif hakları karilerine aittir."
