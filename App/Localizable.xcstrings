    "Turkey's Diyanet, used by Turkish mosques worldwide.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رئاسة الشؤون الدينية التركية، تتبعها المساجد التركية حول العالم."
          }
        },
        "de": {
