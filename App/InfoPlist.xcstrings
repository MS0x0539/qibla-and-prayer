{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Asked when the Qibla camera opens.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر الكاميرا اتجاه مكة على الصورة المباشرة. لا يُسجَّل شيء ولا يُحفظ ولا يُرسَل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera zeigt die Richtung nach Mekka im Livebild. Nichts wird aufgenommen, gespeichert oder gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera shows the way to Mecca on the live picture. Nothing is recorded, saved or sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo montre la direction de La Mecque sur l’image en direct. Rien n’est enregistré, conservé ni envoyé."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera toont de richting van Mekka op het live beeld. Er wordt niets opgenomen, bewaard of verstuurd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera, canlı görüntüde Mekke'nin yönünü gösterir. Hiçbir şey kaydedilmez, saklanmaz ya da gönderilmez."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة. لا يشاركه هذا التطبيق مع أحد سوى خرائط Apple، التي تحدد اسم المكان وتعرض الخريطة وتبحث عن المساجد القريبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wird genutzt, um Gebetszeiten und die Qibla-Richtung zu berechnen. Außer an Apple Karten, das den Ort benennt, die Karte zeigt und Moscheen in der Nähe sucht, gibt diese App ihn an niemanden weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location is used to calculate prayer times and the Qibla direction. Apart from Apple Maps, which names the place, shows the map and finds mosques nearby, this app shares it with no one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position sert à calculer les horaires de prière et la direction de la qibla. Seul Plans d’Apple la reçoit, pour nommer le lieu, afficher la carte et trouver les mosquées proches ; cette app ne la partage avec personne d’autre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie wordt gebruikt om de gebedstijden en de qibla-richting te berekenen. Behalve met Apple Kaarten, dat de plaats benoemt, de kaart toont en moskeeën in de buurt zoekt, deelt deze app hem met niemand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz namaz vakitlerini ve kıble yönünü hesaplamak için kullanılır. Bu uygulama konumunuzu, yerin adını bulan, haritayı gösteren ve yakındaki camileri arayan Apple Haritalar dışında kimseyle paylaşmaz."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Asked when someone saves an image they share (a page, a verse, the day's times) to Photos.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتحفظ في الصور صفحةً أو آيةً أو مواقيت اليوم التي تشاركها كصورة. لا يستطيع التطبيق رؤية صورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit kannst du eine Seite, einen Vers oder die Gebetszeiten des Tages, die du als Bild teilst, in Fotos sichern. Die App kann deine Fotos nicht sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you save a page, verse or the day's prayer times that you share as an image to Photos. The app can't see your photos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer dans Photos une page, un verset ou les horaires du jour que vous partagez en image. L’app ne peut pas voir vos photos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee bewaar je een pagina, vers of de gebedstijden van vandaag die je als afbeelding deelt in Foto's. De app kan je foto's niet zien."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel olarak paylaştığınız bir sayfayı, ayeti ya da günün namaz vakitlerini Fotoğraflar'a kaydedebilmeniz için. Uygulama fotoğraflarınızı göremez."
          }
        }
      }
    }
  },
  "version": "1.0"
}
